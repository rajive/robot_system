<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.7.0/rti_dds_qos_profiles.xsd"
     version="7.7.0">

    <!--
        QoS profiles for the simple robot system.

        Design rules:
          * Sensor streams  -> best effort + volatile (freshness over repair)
          * Actuator cmds   -> reliable + volatile (never replay old actions)
          * Actuator status -> reliable + transient-local (late joiners get state)
          * Telemetry       -> reliable + transient-local (dashboard snapshot)
    -->
    <qos_library name="RobotQosLibrary">

        <!-- 50 Hz periodic sensor stream: prefer fresh data over repair latency. -->
        <qos_profile name="SensorPeriodic"
                     base_name="BuiltinQosLib::Pattern.PeriodicData">
            <datawriter_qos>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>5</depth>
                </history>
                <deadline>
                    <period>
                        <sec>0</sec>
                        <nanosec>20000000</nanosec>
                    </period>
                </deadline>
            </datawriter_qos>

            <datareader_qos>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>5</depth>
                </history>
                <deadline>
                    <period>
                        <sec>0</sec>
                        <nanosec>30000000</nanosec>
                    </period>
                </deadline>
            </datareader_qos>
        </qos_profile>

        <!-- Discrete actuator commands: reliable, but never replay old actions. -->
        <qos_profile name="ActuatorCommandEvent"
                     base_name="BuiltinQosLib::Pattern.Event">
            <datawriter_qos>
                <durability>
                    <kind>VOLATILE_DURABILITY_QOS</kind>
                </durability>
                <resource_limits>
                    <max_samples>128</max_samples>
                    <max_samples_per_instance>32</max_samples_per_instance>
                </resource_limits>
            </datawriter_qos>

            <datareader_qos>
                <durability>
                    <kind>VOLATILE_DURABILITY_QOS</kind>
                </durability>
                <resource_limits>
                    <max_samples>128</max_samples>
                    <max_samples_per_instance>32</max_samples_per_instance>
                </resource_limits>
            </datareader_qos>
        </qos_profile>

        <!-- Latest actuator state, available immediately to late joiners. -->
        <qos_profile name="ActuatorStatusState"
                     base_name="BuiltinQosLib::Pattern.Status">
            <datawriter_qos>
                <deadline>
                    <period>
                        <sec>0</sec>
                        <nanosec>100000000</nanosec>
                    </period>
                </deadline>
            </datawriter_qos>

            <datareader_qos>
                <deadline>
                    <period>
                        <sec>0</sec>
                        <nanosec>150000000</nanosec>
                    </period>
                </deadline>
            </datareader_qos>
        </qos_profile>

        <!-- Dashboard snapshot: one latest value per entity. -->
        <qos_profile name="TelemetrySnapshot"
                     base_name="BuiltinQosLib::Pattern.Status">
            <datawriter_qos>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>1</depth>
                </history>
            </datawriter_qos>

            <datareader_qos>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>1</depth>
                </history>
            </datareader_qos>
        </qos_profile>

    </qos_library>
</dds>
